{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap.xml"
    },
    {
      "source": "/product/:id",
      "has": [
        {
          "type": "query",
          "key": "lang",
          "value": "en"
        }
      ],
      "destination": "/seo/en/product/:id.html"
    },
    {
      "source": "/product/:id",
      "destination": "/seo/zh/product/:id.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
